.DS_Store
node_modules/
.next/
dist/
.build/
__pycache__/
*.pyc
.reco-training/
*.dmg
*.zip
*.recomodel
*.mp4
*.mov
*.m4v
*.avi
*.mkv
*.webm
# Exception: the bundled, AI-generated onboarding walkthrough videos (never
# real user footage) - see mac/Sources/RecoTrainerMac/Resources/ and
# cross-platform/public/. Everything else stays covered by the blanket
# video-file rule above, which exists specifically so no one's real training
# footage ever ends up committed to this repo by accident.
!mac/Sources/RecoTrainerMac/Resources/walkthrough-*.mp4
!cross-platform/public/walkthrough-*.mp4

# No picture of a training set, generated or real, may ever reach this repository.
# The exceptions are the app's own icons, documentation and UI assets.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.heic
*.tif
*.tiff
!mac/Assets/**
!mac/Assets.xcassets/**
!mac/Sources/RecoTrainerMac/Resources/**
!cross-platform/public/**
!docs/screenshots/**
!docs/training-video/**
